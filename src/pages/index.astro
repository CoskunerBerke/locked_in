---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import ServiceTicker from '../components/sections/ServiceTicker.astro';
import BentoGrid from '../components/sections/BentoGrid.astro';
import FoodDeliverySpecial from '../components/sections/FoodDeliverySpecial.astro';
import CanvasFallback from '../components/3d/CanvasFallback.astro';
import WorkProcess from '../components/sections/WorkProcess.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import brandConfig from '../config/brand';
---

<Layout
  title={`${brandConfig.brandName} - Dijital Görünürlük ve Danışmanlık Hizmetleri`}
  description={brandConfig.description}
  activePage="/"
>
  <HeroSection />
  <ServiceTicker />
  <BentoGrid />
  <FoodDeliverySpecial />
  <CanvasFallback />
  <WorkProcess />
  <WhyUs />
  <FAQSection />
  <FinalCTA />
</Layout>
