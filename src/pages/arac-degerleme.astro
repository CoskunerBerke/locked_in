---
/**
 * ARAC DEGERLEME — SINIRLI PUBLIC DEMO
 *
 * Statik uretilir (`output: 'static'`), React adasi tarayicida calisir.
 * Sunucu, SSR, API rotasi veya serverless fonksiyon YOKTUR: cikti
 * `dist/arac-degerleme/index.html` ve yanindaki varliklardir, paylasimli
 * hosting'e oldugu gibi yuklenir.
 *
 * Fiyat verisi `public/data/public-vehicle-demo.json` dosyasindan gelir ve o
 * dosya YALNIZCA public demoya acik araclarin verisini tasir. Kilit arayuzde
 * degil VERIDE uygulanir. Veri seti ve hesaplayici `rentyazilim-public-demo`
 * deposundan (feature/vehicle-valuation-public-demo) birebir tasindi; burada
 * yalnizca sayfanin dis kabugu bu sitenin ic sayfa duzenine uyarlandi.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PublicVehicleDemo from '../components/arac-degerleme/PublicVehicleDemo';
import { FULL_CATALOG_FACTS } from '../config/public-demo.config';
import brandConfig from '../config/brand';
import { Database, ShieldCheck, Layers } from 'lucide-react';
import '../styles/arac-degerleme.css';

const title = `Araç Değerleme Sistemi (Demo) | ${brandConfig.brandName}`;
const description =
  'Rent Yazılım tarafından geliştirilen, gerçek piyasa verilerinden türetilen otomatik araç fiyatlandırma altyapısını sınırlı demo sürümüyle deneyin.';

const breadcrumbItems = [{ name: 'Araç Değerleme', href: '/arac-degerleme/' }];

/** MEVCUT iletisim kanali; bu sayfa icin yeni numara uretilmez. */
const contactMessage =
  'Merhabalar, araç değerleme sisteminin tam sürümü hakkında bilgi almak istiyorum.';
const contactHref = `https://wa.me/${brandConfig.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(contactMessage)}`;

const dataUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/data/public-vehicle-demo.json`;

const facts = [
  { icon: Layers, label: `${FULL_CATALOG_FACTS.brands} marka`, sub: 'tam sistem kataloğu' },
  { icon: Database, label: `${FULL_CATALOG_FACTS.models} model`, sub: 'değişken derinlikli hiyerarşi' },
  {
    icon: ShieldCheck,
    label: `${FULL_CATALOG_FACTS.trims.toLocaleString('tr-TR')}+ donanım`,
    sub: 'gerçek ilan kanıtına dayalı',
  },
];
---

<Layout title={title} description={description} activePage="/arac-degerleme/">
  <div class="rv-page bg-slate-50 border-b border-slate-200">
    <section class="mx-auto max-w-5xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16 lg:px-8">
      <Breadcrumb items={breadcrumbItems} title="Araç Değerleme" />

      <header class="mb-8">
        <div class="rv-rise inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-100/80 px-3 py-1 text-xs font-bold uppercase tracking-widest text-sky-700">
          Demo — Sınırlı Sürüm
        </div>
        <h1 class="rv-rise rv-delay-1 mt-4 text-[2rem] font-extrabold leading-[1.1] tracking-tight text-slate-900 md:text-[2.75rem]">
          Araç Değerleme Sistemi
        </h1>
        <p class="rv-rise rv-delay-2 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-slate-600">
          Gerçek piyasa verilerinden geliştirilen otomatik araç fiyatlandırma
          altyapısını deneyin. Aracınızı seçin; nakit alım teklifini ve konsinye
          ile elinize geçecek tutarı anında görün.
        </p>
        <p class="rv-rise rv-delay-2 mt-2 text-xs text-slate-500">
          Bu sayfa ürünün sınırlı demo sürümüdür. Araç kataloğu seçili
          modellerle sınırlandırılmıştır.
        </p>
      </header>

      <PublicVehicleDemo client:load dataUrl={dataUrl} contactHref={contactHref} />

      {/*
        TAM SISTEM KAPASITESI — olculen degerler, iddia degil.
        "7.092 aracin hepsinde her zaman guncel fiyat var" DENMEZ; katalog
        genisligi ile fiyat kaniti olan donanim sayisi ayri yazilir.
      */}
      <section class="rv-rise rv-delay-4 mt-12 rounded-2xl border border-slate-200 bg-white p-6 md:p-8">
        <h2 class="text-lg font-extrabold text-slate-900">Tam sistem kapasitesi</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
          Demoda seçili araçlar açıktır. Tam sürümde sistemin tamamı kullanılabilir.
        </p>
        <dl class="mt-6 grid gap-5 sm:grid-cols-3">
          {
            facts.map((fact) => (
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-700">
                  <fact.icon size={18} aria-hidden="true" />
                </div>
                <div>
                  <dt class="text-base font-extrabold text-slate-900">{fact.label}</dt>
                  <dd class="mt-0.5 text-xs text-slate-500">{fact.sub}</dd>
                </div>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 border-t border-slate-200 pt-4 text-xs leading-relaxed text-slate-500">
          Kataloğun {FULL_CATALOG_FACTS.pricedTrims.toLocaleString('tr-TR')} donanımında
          güncel emsal kanıtı bulunur ve otomatik fiyat üretilir. Kalan
          donanımlarda kaynakta ilan bulunmadığı için fiyat üretilmez; sistem
          tahmin yürütmek yerine bunu açıkça belirtir.
        </p>
        <a
          href={contactHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-sky-600/20 transition-colors hover:bg-sky-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2"
        >
          Tam Sürüm İçin İletişime Geç
        </a>
      </section>
    </section>
  </div>
</Layout>
