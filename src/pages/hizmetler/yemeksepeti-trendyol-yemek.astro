---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Yemeksepeti ve Trendyol Yemek Panel Kurulumu & Danışmanlığı | ${brandConfig.brandName}`;
const pageDescription = 'Restoranlar için Yemeksepeti ve Trendyol Yemek panel kurulumu, başvuru desteği, menü ve kategori düzenleme, fiyat güncellemeleri ve panel danışmanlığı sunuyoruz.';

const serviceSchema = getServiceSchema(
  'Yemeksepeti ve Trendyol Yemek Panel Kurulumu ve Mağaza Danışmanlığı',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/yemeksepeti-trendyol-yemek/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'Yemeksepeti & Trendyol Yemek', url: '/hizmetler/yemeksepeti-trendyol-yemek/' },
];

const metrics = [
  { value: '1-3 Gün', label: 'Kurulum & Onay', subtext: 'Hızlı Aktivasyon' },
  { value: '%100', label: 'Menü Doğruluğu', subtext: 'Eksiksiz Giriş' },
  { value: '7/24', label: 'Operasyon Takibi', subtext: 'Kesintisiz Destek' },
];

const features = [
  {
    title: 'Mağaza & Panel Kurulum Desteği',
    description: 'Platformlara başvuru, gerekli evrak tamamlama ve restoran profilinizin doğru bilgilerle onaylanması adımlarında profesyonel rehberlik.',
  },
  {
    title: 'Menü, Ürün & Kategori Düzenleme',
    description: 'Yemek isimleri, porsiyon seçenekleri, iştah açıcı ürün açıklamaları, fiyat güncellemeleri ve doğru kategori hiyerarşisi kurulumu.',
  },
  {
    title: 'Çalışma Saatleri & Tatil Modu',
    description: 'Açılış/kapanış saatlerinin güncellenmesi, yoğun anlarda geçici sipariş duraklatma ve kurye teslimat bölgesi optimizasyonu.',
  },
  {
    title: 'Kampanya & Performans Takibi',
    description: 'Platform içi promosyon ve kupon katılım düzenlemeleri, iptal/gecikme oranlarının düşürülmesi ve mağaza puanı takibi.',
  },
];

const relatedServices = [
  {
    title: 'Google Maps ve Yerel SEO',
    url: '/hizmetler/google-maps/',
    description: 'Restoranınızın haritalardaki bulunabilirliğini artırın.',
  },
  {
    title: 'Instagram ve Meta Reklamları',
    url: '/hizmetler/instagram-reklamlari/',
    description: 'Çevrenizdeki lezzet tutkunlarına doğrudan ulaşın.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="yemeksepeti"
  categoryBadge="Restoran & Yemek Platformları"
  heroTitle="Yemeksepeti ve Trendyol Yemek"
  heroTitleHighlight="Panel Kurulumu & Yönetimi"
  heroDescription="Restoranınızın yemek sipariş platformlarındaki operasyonel yükünü hafifletin. Menü güncellemeleri, ürün açıklamaları, fiyat düzenlemeleri ve çalışma saatlerini sizin yerinize eksiksiz takip ediyoruz."
  ctaText="Panel Yönetimi Teklifi Alın"
  badgeClass="bg-rose-50 text-[#EA004B] border-rose-200"
  primaryBtnClass="bg-gradient-to-r from-[#EA004B] to-[#F27A1A] hover:opacity-95 text-white shadow-rose-900/20"
  heroGlowClass="bg-rose-500/10"
  showcaseTitle="Çift Platform Restoran Entegrasyonu"
  showcaseSubtitle="Yemeksepeti ve Trendyol Yemek mağazanızı profesyonel panel desteğiyle güçlendirin."
  metrics={metrics as any}
  contentTitle="Panel Yönetimi Kapsamında Sunduğumuz Çözümler"
  contentSubtitle="Sipariş akışını aksatmadan, dijital menünüzü ve mağaza profilinizi her zaman güncel tutuyoruz."
  features={features as any}
  disclaimerTitle="Marka Sahipliği ve Yasal Beyan:"
  disclaimerText={`Yemeksepeti ve Trendyol Yemek markaları kendi tescilli hak sahiplerine aittir. ${brandConfig.brandName}, restoran işletmelerine bağımsız panel operasyon desteği, menü yönetimi ve dijital danışmanlık hizmeti sağlamaktadır. Bu şirketlerle herhangi bir resmî ortaklık, yetkili acentelik veya temsilcilik bağımız bulunmamaktadır.`}
  relatedServices={relatedServices}
/>
