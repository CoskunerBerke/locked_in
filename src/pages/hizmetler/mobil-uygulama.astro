---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Mobil Uygulama Tasarımı ve Geliştirme (iOS & Android) | ${brandConfig.brandName}`;
const pageDescription = 'İşletmeniz için modern, hızlı ve kullanıcı dostu iOS ve Android mobil uygulamaları geliştiriyoruz.';

const serviceSchema = getServiceSchema(
  'Mobil Uygulama Tasarımı ve Geliştirme',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/mobil-uygulama/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'Mobil Uygulama', url: '/hizmetler/mobil-uygulama/' },
];

const metrics = [
  { value: 'iOS & Android', label: 'Çift Mağaza', subtext: 'Eşzamanlı Yayın' },
  { value: '60 FPS', label: 'Akıcı Arayüz', subtext: 'Yüksek Performans' },
  { value: 'Push Bildirim', label: 'Anlık İletişim', subtext: 'Müşteri Etkileşimi' },
];

const features = [
  {
    title: 'Çapraz Platform Mimari (React Native / Flutter)',
    description: 'Tek bir modern ve temiz kod tabanı ile hem iOS hem Android cihazlarda sıfır performans kaybıyla eşzamanlı çalışma.',
  },
  {
    title: 'Kullanıcı Dostu UX/UI Arayüz Tasarımı',
    description: 'Kullanıcıların tek parmakla rahatça gezinebildiği, dokunma hissiyatı yüksek, şık ve markanıza özel mobil ekranlar.',
  },
  {
    title: 'Push Bildirim & API / Veritabanı Entegrasyonu',
    description: 'Kampanyalar için anlık bildirim sistemi, SMS, güvenli ödeme sistemleri ve mevcut web sitenizle senkronizasyon.',
  },
  {
    title: 'App Store & Google Play Onay Süreci',
    description: 'Geliştirici hesap açılışları, mağaza içi görsel hazırlıkları, gizlilik politikaları ve mağaza onay süreçlerinin takibi.',
  },
];

const relatedServices = [
  {
    title: 'Kurumsal Web Sitesi Tasarımı',
    url: '/hizmetler/web-sitesi-tasarimi/',
    description: 'Mobil uygulamanızı tamamlayan modern bir web sitesi.',
  },
  {
    title: 'Instagram ve Meta Reklamları',
    url: '/hizmetler/instagram-reklamlari/',
    description: 'Uygulama yükleme (App Install) reklamlarıyla kullanıcı kazanın.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="mobil-uygulama"
  categoryBadge="iOS & Android Çözümleri"
  heroTitle="Mobil Uygulama Geliştirme"
  heroTitleHighlight="App Store & Google Play"
  heroDescription="Müşterilerinizin cebinde yer alın. Hem iOS hem de Android platformlarında akıcı, yüksek performanslı ve modern kullanıcı deneyimi sunan mobil uygulamalar geliştiriyoruz."
  ctaText="Mobil Projenizi Konuşalım"
  badgeClass="bg-slate-100 text-slate-800 border-slate-300"
  primaryBtnClass="bg-slate-900 hover:bg-slate-800 text-white shadow-slate-900/20"
  heroGlowClass="bg-sky-500/10"
  showcaseTitle="Çapraz Platform Mobil Mimari"
  showcaseSubtitle="Apple App Store ve Google Play Store için tek kod altyapısıyla maksimum verim."
  metrics={metrics as any}
  contentTitle="Mobil Uygulama Kapsamında Sunduğumuz Çözümler"
  contentSubtitle="Fikrinizi App Store ve Google Play'de yayınlanan güçlü bir ürüne dönüştürüyoruz."
  features={features as any}
  disclaimerTitle="Yasal Bilgilendirme ve Ekosistem Uyumu:"
  disclaimerText={`Apple, App Store ve iOS markaları Apple Inc.; Android ve Google Play markaları Google LLC tescilli markalarıdır. ${brandConfig.brandName}, işletmelere bağımsız mobil yazılım geliştirme, mimari tasarım ve mağaza yayını danışmanlığı sağlamaktadır.`}
  relatedServices={relatedServices}
/>
