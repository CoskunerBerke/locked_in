---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Instagram ve Meta Reklam Yönetimi | ${brandConfig.brandName}`;
const pageDescription = 'Hedef kitlenize doğrudan ulaşın. Instagram ve Facebook reklam kampanya stratejileri, içerik kurguları ve bütçe performans takibi.';

const serviceSchema = getServiceSchema(
  'Instagram ve Meta Reklam Yönetimi',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/instagram-reklamlari/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'Instagram Reklamları', url: '/hizmetler/instagram-reklamlari/' },
];

const metrics = [
  { value: '%300+', label: 'ROAS Hedefi', subtext: 'Yüksek Dönüşüm' },
  { value: 'Nokta Atışı', label: 'Hedef Kitle', subtext: 'Konum & İlgi Alanı' },
  { value: 'Haftalık', label: 'Şeffaf Rapor', subtext: 'Düzenli Takip' },
];

const features = [
  {
    title: 'Hassas Hedef Kitle Analizi',
    description: 'Demografik veriler, yerel bölge/ilçe yarıçapı, ilgi alanları ve satın alma davranışlarına göre nokta atışı kitle filtreleme.',
  },
  {
    title: 'Kreatif & Metin Stratejisi',
    description: 'Dönüşüm odaklı başlıklar, harekete geçirici mesajlar (CTA) ve dikkat çeken video/görsel reklam kurguları geliştirme.',
  },
  {
    title: 'Bütçe & ROAS Optimizasyonu',
    description: 'Reklam bütçenizin en verimli şekilde harcanması, tıklama ve dönüşüm başı maliyetlerin (CPA) düşürülmesi.',
  },
  {
    title: 'A/B Testleri & Şeffaf Raporlama',
    description: 'Farklı görsel ve hedef kitlelerin eşzamanlı test edilmesi, haftalık ve aylık şeffaf performans paneli sunumu.',
  },
];

const relatedServices = [
  {
    title: 'Kurumsal Web Sitesi Tasarımı',
    url: '/hizmetler/web-sitesi-tasarimi/',
    description: 'Reklam trafiğinizi yüksek dönüşümlü bir web sitesine yönlendirin.',
  },
  {
    title: 'Google Maps ve Yerel SEO',
    url: '/hizmetler/google-maps/',
    description: 'Yerel müşterilerinizi fiziksel konumunuza çekin.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="instagram"
  categoryBadge="Sosyal Medya & Meta Reklamları"
  heroTitle="Instagram ve Meta Reklamları"
  heroTitleHighlight="Hedefli Kampanya Yönetimi"
  heroDescription="Doğru hedef kitleye doğru mesajla ulaşın. Reklam kurgularından görsel yönlendirmelere ve bütçe optimizasyonuna kadar sosyal medya reklamlarınızı profesyonelce yönetiyoruz."
  ctaText="Reklam Danışmanlığı İsteyin"
  badgeClass="bg-pink-50 text-[#E1306C] border-pink-200"
  primaryBtnClass="bg-gradient-to-r from-[#833AB4] via-[#FD1D1D] to-[#F77737] hover:opacity-95 text-white shadow-pink-900/20"
  heroGlowClass="bg-pink-500/10"
  showcaseTitle="Meta Reklam Yöneticisi Entegrasyonu"
  showcaseSubtitle="Instagram ve Facebook akışlarında yüksek dönüşümlü hedefli reklam kampanyaları."
  metrics={metrics as any}
  contentTitle="Instagram Reklam Stratejimiz ve Süreçlerimiz"
  contentSubtitle="Reklam bütçenizi boşa harcamadan, doğrudan satın alma potansiyeli yüksek kitleye ulaşıyoruz."
  features={features as any}
  disclaimerTitle="Yasal Not ve Marka Sahipliği:"
  disclaimerText={`Instagram ve Meta markaları Meta Platforms Inc. şirketine aittir. Reklam bütçeleri doğrudan Meta hesabınıza tanımlanır; ${brandConfig.brandName} bağımsız kampanya stratejisi, hedefleme kurgusu ve reklam yönetim danışmanlığı sağlamaktadır.`}
  relatedServices={relatedServices}
/>
