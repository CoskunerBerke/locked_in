---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Google Maps İşletme Optimizasyonu ve Konum Yönetimi | ${brandConfig.brandName}`;
const pageDescription = 'İşletmenizin Google Haritalar görünürlüğünü artırın. Google İşletme Profili düzenleme, doğrulama, kategori optimizasyonu ve yerel müşteri yönetimi.';

const serviceSchema = getServiceSchema(
  'Google Maps İşletme Optimizasyonu ve Konum Yönetimi',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/google-maps/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'Google Maps', url: '/hizmetler/google-maps/' },
];

const metrics = [
  { value: '%100', label: 'Eksiksiz Profil', subtext: 'Google Kriterleri' },
  { value: '3 Kat', label: 'Yol Tarifi Artışı', subtext: 'Yerel Müşteriler' },
  { value: '5.0 ★', label: 'İtibar Yönetimi', subtext: 'Pozitif İncelemeler' },
];

const features = [
  {
    title: 'Profil Doğrulama & İleri Kurulum',
    description: 'İşletme adı, tam cadde adresi, sabit hat/mobil telefon, web sitesi ve açılış/kapanış saatlerinin doğrulanıp eksiksiz girilmesi.',
  },
  {
    title: 'Doğru Kategori & Hizmet Listesi',
    description: 'İşletmenizi Google yerel aramalarında en doğru temsil eden birincil/ikincil kategorilerin ve alt hizmet kalemlerinin seçilmesi.',
  },
  {
    title: 'Fotoğraf, Menü & Ürün Vitrini',
    description: 'Mekan içi, dış cephe, menü, ürün ve hizmet fotoğraflarının optimize edilerek profilde etkileşim yaratacak şekilde sunulması.',
  },
  {
    title: 'Yorum Yönetimi & Yerel Sinyaller',
    description: 'Gelen müşteri incelemelerine profesyonel yanıt stratejileri, yerel atıf (NAP) tutarlılığı ve harita sıralama sinyallerinin güçlendirilmesi.',
  },
];

const relatedServices = [
  {
    title: 'Teknik ve Site İçi SEO',
    url: '/hizmetler/seo/',
    description: 'Google web aramalarında organik olarak üst sıralara çıkın.',
  },
  {
    title: 'Kurumsal Web Sitesi Tasarımı',
    url: '/hizmetler/web-sitesi-tasarimi/',
    description: 'Haritanızdaki müşterileri modern bir web sitesiyle karşılayın.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="google-maps"
  categoryBadge="Yerel Görünürlük & Harita SEO"
  heroTitle="Google Maps İşletme Optimizasyonu"
  heroTitleHighlight="Yerel Konum & Harita Sıralaması"
  heroDescription="Fiziksel konumunuzu ve hizmetlerinizi arayan yerel müşterilere doğrudan ulaşın. Google İşletme Profilinizi eksiksiz yapılandırarak harita görünürlüğünüzü ve müşteri aramalarınızı katlıyoruz."
  ctaText="Harita Optimizasyon Teklifi Alın"
  badgeClass="bg-blue-50 text-[#1A73E8] border-blue-200"
  primaryBtnClass="bg-[#1A73E8] hover:bg-[#1557b0] text-white shadow-blue-900/20"
  heroGlowClass="bg-blue-500/10"
  showcaseTitle="Google İşletme Profili Doğrulaması"
  showcaseSubtitle="Google Haritalar ve yerel arama paketinde ilk sıralara yükselin."
  metrics={metrics as any}
  contentTitle="Google Harita Optimizasyonunda Sunduğumuz Çözümler"
  contentSubtitle="Bölgenizdeki potansiyel müşterilerin sizi ilk sırada görmesi için yerel SEO adımlarını uyguluyoruz."
  features={features as any}
  disclaimerTitle="Yasal Not ve Tescilli Marka Bildirimi:"
  disclaimerText={`Google ve Google Maps markaları Google LLC şirketine aittir. ${brandConfig.brandName}, bağımsız bir dijital ajans olarak işletmelerin Google İşletme Profili optimizasyonu ve yerel görünürlük danışmanlığı süreçlerini yönetmektedir.`}
  relatedServices={relatedServices}
/>
