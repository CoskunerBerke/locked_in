---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Ankara SEO Hizmeti, Teknik ve Yerel SEO | ${brandConfig.brandName}`;
const pageDescription = 'Ankara SEO hizmetimizle arama motorlarında üst sıralara çıkın. Teknik SEO, site içi içerik optimizasyonu ve yerel harita stratejileri ile organik trafiğinizi artırıyoruz.';

const serviceSchema = getServiceSchema(
  'Ankara SEO Hizmeti, Teknik ve Yerel SEO',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/seo/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'SEO Hizmetleri', url: '/hizmetler/seo/' },
];

const metrics = [
  { value: '100/100', label: 'Lighthouse Hız', subtext: 'Core Web Vitals' },
  { value: '1. Sayfa', label: 'Hedef Sıralama', subtext: 'Organik Kelimeler' },
  { value: 'Beyaz Şapka', label: 'Etik SEO', subtext: 'Google Yönergeleri' },
];

const features = [
  {
    title: 'Kapsamlı Teknik SEO & Site Hızı',
    description: 'Google Core Web Vitals optimizasyonu, mobil taranabilirlik, sitemap.xml, robots.txt ve temiz kod yapısı kurulumu.',
  },
  {
    title: 'Site İçi (On-Page) & Semantik Mimari',
    description: 'H1-H6 başlık hiyerarşisi, meta etiketleri, zengin snippet (Schema.org) işaretlemeleri ve anahtar kelime yerleşimi.',
  },
  {
    title: 'Yerel (Local) SEO & Harita Sinyalleri',
    description: 'Bölgesel aramalarda öne çıkmak için Google İşletme Profili uyumu, yerel rehber kayıtları ve konum sinyali inşası.',
  },
  {
    title: 'Rakip Analizi & Şeffaf Sıralama Takibi',
    description: 'Sektörünüzdeki güçlü rakiplerin incelenmesi, arama hacmi yüksek anahtar kelimelerin analizi ve aylık sıralama raporları.',
  },
];

const relatedServices = [
  {
    title: 'Google Maps Optimizasyonu',
    url: '/hizmetler/google-maps/',
    description: 'Harita aramalarında yerel müşterilerinize ulaşın.',
  },
  {
    title: 'Kurumsal Web Sitesi Tasarımı',
    url: '/hizmetler/web-sitesi-tasarimi/',
    description: 'SEO uyumlu, hızlı ve modern kurumsal web sitesi.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="seo"
  categoryBadge="Organik Büyüme & Arama Motoru"
  heroTitle="Ankara SEO Hizmeti"
  heroTitleHighlight="Teknik ve Yerel SEO Çözümleri"
  heroDescription="Arama motorlarında üst sıralara tırmanmak için web sitenizin kod yapısını, hızını, içerik mimarisini ve yerel harita verilerini eksiksiz optimize ediyoruz."
  ctaText="SEO Analizi ve Teklif İsteyin"
  badgeClass="bg-emerald-50 text-emerald-700 border-emerald-200"
  primaryBtnClass="bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-900/20"
  heroGlowClass="bg-emerald-500/10"
  showcaseTitle="Google Search & Core Web Vitals"
  showcaseSubtitle="Arama motoru algoritmalarına %100 uyumlu, sürdürülebilir organik büyüme."
  metrics={metrics as any}
  contentTitle="SEO Çalışması Kapsamında Sunduğumuz Çözümler"
  contentSubtitle="Reklam bütçelerine bağımlı kalmadan organik müşteri trafiğinizi katlayın."
  features={features as any}
  disclaimerTitle="Önemli Bilgilendirme ve Etik Beyan:"
  disclaimerText="Arama motorlarının algoritmaları bağımsız olarak güncellenmektedir. Şirketimiz %100 birinci sıra veya kesin organik trafik garantisi gibi kanıtlanamayacak vaatlerde bulunmaz; uluslararası kabul görmüş etik beyaz şapka (White Hat) SEO yöntemlerini uygular."
  relatedServices={relatedServices}
/>
