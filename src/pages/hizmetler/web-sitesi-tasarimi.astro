---
import ServicePageLayout from '../../components/templates/ServicePageLayout.astro';
import { getServiceSchema } from '../../utils/jsonLd';
import brandConfig from '../../config/brand';

const pageTitle = `Ankara Web Tasarım ve Kurumsal Web Sitesi | ${brandConfig.brandName}`;
const pageDescription = 'Ankara web tasarım çözümlerimizle işletmenize özel, mobil uyumlu, yüksek hızlı ve Google arama motoru dostu kurumsal web siteleri geliştiriyoruz.';

const serviceSchema = getServiceSchema(
  'Ankara Web Tasarım ve Kurumsal Web Sitesi Hizmeti',
  pageDescription,
  `${brandConfig.siteUrl}/hizmetler/web-sitesi-tasarimi/`
);

const breadcrumbs = [
  { name: 'Hizmetler', url: '/#hizmetler' },
  { name: 'Web Sitesi Tasarımı', url: '/hizmetler/web-sitesi-tasarimi/' },
];

const metrics = [
  { value: '0.4sn', label: 'Yükleme Hızı', subtext: 'Işık Hızında' },
  { value: '%100', label: 'Mobil Uyum', subtext: 'Responsive Arayüz' },
  { value: 'SSL & SEO', label: 'Güvenli Altyapı', subtext: 'Tam Donanımlı' },
];

const features = [
  {
    title: 'Özel UI/UX Arayüz & Wireframe Tasarımı',
    description: 'Hazır ve hantal temalar yerine firmanızın kimliğine, hedef kitlesine ve sektörüne özel, estetik ve prestijli sayfa kurguları.',
  },
  {
    title: '%100 Responsive Mobil & Tablet Uyumu',
    description: 'Akıllı telefonlar, tabletler ve geniş masaüstü ekranlarda kusursuz piksel dizilimi ve akıcı dokunmatik navigasyon.',
  },
  {
    title: 'Astro & Tailwind ile Yüksek Hızlı Kodlama',
    description: 'Ağır WordPress altyapıları yerine saliseler içinde açılan, Google Core Web Vitals testlerinden tam not alan modern statik mimari.',
  },
  {
    title: 'SSL Güvenlik, WhatsApp & Dinamik Formlar',
    description: 'Ücretsiz SSL güvenlik sertifikası, WhatsApp hızlı iletişim butonu, dinamik teklif formları ve Google Haritalar entegrasyonu.',
  },
];

const relatedServices = [
  {
    title: 'Ankara SEO ve Teknik SEO',
    url: '/hizmetler/seo/',
    description: 'Yeni sitenizi arama motorlarında ilk sıralara taşıyın.',
  },
  {
    title: 'Google Maps ve Yerel SEO',
    url: '/hizmetler/google-maps/',
    description: 'Harita kaydınız ile sitenizi birleştirerek yerel müşteri kazanın.',
  },
];
---

<ServicePageLayout
  title={pageTitle}
  description={pageDescription}
  customSchema={serviceSchema}
  breadcrumbs={breadcrumbs}
  serviceKey="web-tasarim"
  categoryBadge="Kurumsal Web Çözümleri"
  heroTitle="Kurumsal Web Sitesi Tasarımı"
  heroTitleHighlight="Modern Tasarım & Işık Hızında Kod"
  heroDescription="Dijital dünyadaki en güçlü vitrininiz olan web sitenizi modern tasarım trendleri, yüksek mobil uyum ve satış/dönüşüm odaklı temiz mimariyle inşa ediyoruz."
  ctaText="Web Siteniz İçin Teklif Alın"
  badgeClass="bg-sky-50 text-sky-700 border-sky-200"
  primaryBtnClass="bg-sky-600 hover:bg-sky-700 text-white shadow-sky-900/20"
  heroGlowClass="bg-sky-500/10"
  showcaseTitle="Modern Web & Mobil Deneyimi"
  showcaseSubtitle="Astro & React tabanlı statik mimariyle 99+ PageSpeed hızı ve kusursuz mobil uyum."
  metrics={metrics as any}
  contentTitle="Web Tasarımı Kapsamında Sunduğumuz Çözümler"
  contentSubtitle="İşletmenizin kurumsal kimliğini internette en prestijli şekilde temsil eden nitelikler."
  features={features as any}
  disclaimerTitle="Standartlar ve Kalite Taahhüdümüz:"
  disclaimerText="Geliştirdiğimiz tüm kurumsal web siteleri W3C standartlarına, modern web güvenliği ilkelerine ve arama motoru optimizasyonu kriterlerine tam uyumlu olarak teslim edilir. Süreç boyunca kaynak kodlar ve yönetim kontrolleri şeffaf bir şekilde teslim edilir."
  relatedServices={relatedServices}
/>
