---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import brandConfig from '../../config/brand';
import projectsData from '../../data/projects';
import { ExternalLink, CheckCircle2 } from 'lucide-react';

const breadcrumbItems = [{ name: 'Projeler', href: '/projeler/' }];
---

<Layout
  title={`Referanslar ve Canlı Projeler | ${brandConfig.brandName}`}
  description={`${brandConfig.brandName} tarafından geliştirilen kurumsal web tasarımı, SEO altyapıları, harita ve dijital çözümler.`}
  activePage="/projeler/"
>
  <Breadcrumb items={breadcrumbItems} title="Gerçekleştirdiğimiz Projeler" />

  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-3xl space-y-3">
        <h1 class="text-3xl font-black text-slate-900">Canlı Proje ve Referanslarımız</h1>
        <p class="text-slate-600 text-sm leading-relaxed">
          Müşterilerimiz için sıfırdan tasarlayıp yayına aldığımız kurumsal web siteleri, özel yazılım platformları ve dijital çözümler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          projectsData.map((project) => (
            <div class="rounded-2xl border border-slate-200 overflow-hidden bg-white shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
              <div class="relative overflow-hidden aspect-video bg-slate-900">
                <img src={project.image} alt={`${project.title} Ekran Görüntüsü`} class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500" />
                <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-slate-900/90 backdrop-blur-md text-sky-400 text-xs font-bold border border-slate-700">
                  {project.industry}
                </span>
              </div>
              <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <h2 class="text-xl font-bold text-slate-900">{project.title}</h2>
                  <p class="text-xs text-slate-600 leading-relaxed">{project.description}</p>
                </div>

                <div class="flex flex-wrap gap-2 pt-1">
                  {project.services.map((service) => (
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 text-[11px] font-medium">
                      <CheckCircle2 className="w-3 h-3 text-sky-600" />
                      {service}
                    </span>
                  ))}
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs text-slate-400 font-mono">{project.liveUrl.replace('https://', '').replace('http://', '').replace(/\/$/, '')}</span>
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-1.5"
                  >
                    <span>Siteyi İncele</span>
                    <ExternalLink className="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA />
</Layout>
