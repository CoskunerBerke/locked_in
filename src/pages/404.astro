---
import Layout from '../layouts/Layout.astro';
import brandConfig from '../config/brand';

const pageTitle = `Sayfa Bulunamadı (404) | ${brandConfig.brandName}`;
const pageDescription = 'Aradığınız sayfa kaldırılmış, adı değiştirilmiş veya geçici olarak kullanım dışı olabilir.';
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="min-h-[70vh] flex items-center justify-center py-20 bg-slate-50">
    <div class="max-w-md mx-auto px-4 text-center">
      <span class="text-7xl font-black text-sky-600 tracking-wider">404</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-4 mb-2">
        Sayfa Bulunamadı
      </h1>
      <p class="text-sm text-slate-600 mb-8 leading-relaxed">
        {pageDescription}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary w-full sm:w-auto">
          Ana Sayfaya Dön
        </a>
        <a href="/#hizmetler" class="btn-secondary w-full sm:w-auto">
          Hizmetleri İncele
        </a>
      </div>
    </div>
  </section>
</Layout>
