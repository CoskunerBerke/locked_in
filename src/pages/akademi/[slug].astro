---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import brandConfig from '../../config/brand';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Clock, Calendar, User, ArrowLeft, ArrowRight, Tag } from 'lucide-react';

type BlogEntry = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: BlogEntry) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await post.render();

const breadcrumbItems = [
  { name: 'Akademi', href: '/akademi/' },
  { name: post.data.title, href: `/akademi/${post.slug}/` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  dateModified: post.data.updateDate || post.data.publishDate,
  author: {
    '@type': 'Organization',
    name: brandConfig.brandName,
  },
  publisher: {
    '@type': 'Organization',
    name: brandConfig.brandName,
    logo: {
      '@type': 'ImageObject',
      url: `${brandConfig.siteUrl}${brandConfig.logoPath}`,
    },
  },
};
---

<Layout
  title={`${post.data.title} — ${brandConfig.brandName} Akademi`}
  description={post.data.description}
  activePage="/akademi/"
>
  <Breadcrumb items={breadcrumbItems} title={post.data.title} />

  <article class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <!-- Article Header Meta -->
      <div class="space-y-4 border-b border-slate-200 pb-8">
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 font-medium">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 text-sky-700 font-bold uppercase tracking-wider">
            <Tag className="w-3.5 h-3.5" />
            {post.data.category}
          </span>
          <span class="inline-flex items-center gap-1">
            <Clock className="w-3.5 h-3.5 text-slate-400" />
            {post.data.readingTime} Okuma
          </span>
          <span class="inline-flex items-center gap-1">
            <Calendar className="w-3.5 h-3.5 text-slate-400" />
            Yayın: {post.data.publishDate}
          </span>
          <span class="inline-flex items-center gap-1">
            <User className="w-3.5 h-3.5 text-slate-400" />
            {post.data.author}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
          {post.data.title}
        </h1>

        <p class="text-slate-600 text-base sm:text-lg leading-relaxed italic">
          {post.data.description}
        </p>
      </div>

      <!-- Markdown Article Content -->
      <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-p:text-slate-700 prose-p:leading-relaxed prose-li:text-slate-700 text-base">
        <Content />
      </div>

      <!-- Related Service CTA Banner -->
      <div class="mt-12 p-6 rounded-2xl bg-sky-50 border border-sky-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-700 block">İlgili Hizmetimiz</span>
          <h3 class="font-bold text-slate-900 text-base">{post.data.relatedServiceTitle}</h3>
        </div>
        <a href={post.data.relatedServiceHref} class="btn-primary text-xs py-2.5 px-4 shrink-0">
          <span>Hizmeti İncele</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Back to Akademi -->
      <div class="pt-6">
        <a href="/akademi/" class="inline-flex items-center gap-2 text-xs font-bold text-slate-600 hover:text-sky-600 transition-colors">
          <ArrowLeft className="w-4 h-4" />
          <span>Tüm Makale ve Rehberlere Dön</span>
        </a>
      </div>
    </div>
  </article>

  <FinalCTA />

  <!-- Article JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
</Layout>
