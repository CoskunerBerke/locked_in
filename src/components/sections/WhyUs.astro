---
import { ShieldCheck, Smartphone, Search, Target, MessageSquare, Headphones } from 'lucide-react';

const whyUsCards = [
  {
    title: 'Tek Ekip, Uçtan Uca Çözüm',
    desc: 'Tasarım, yazılım, SEO ve sosyal medya reklamlarını farklı ajanslar yerine tek uzman kadrodan yönetin.',
    icon: ShieldCheck,
  },
  {
    title: 'Mobil Öncelikli Tasarım',
    desc: 'Tüm mobil cihazlarda ve tabletlerde %100 uyumlu, yüksek hızlı ve akıcı kullanıcı deneyimi.',
    icon: Smartphone,
  },
  {
    title: 'SEO Uyumlu Altyapı',
    desc: 'Arama motoru botlarının kolayca tarayabildiği semantik kodlama ve hızlı sayfa açılış süreleri.',
    icon: Search,
  },
  {
    title: 'İşletmeye Özel Planlama',
    desc: 'Hazır şablonlar veya kopyala-yapıştır yapılar yerine markanızın hedeflerine özel kurgulanmış dijital sistemler.',
    icon: Target,
  },
  {
    title: 'Şeffaf İletişim',
    desc: 'Proje sürecinin her aşamasında düzenli bilgilendirme, zamanında teslimat ve açık iletişim garantisi.',
    icon: MessageSquare,
  },
  {
    title: 'Yayın Sonrası Destek',
    desc: 'Projeniz canlıya alındıktan sonra da teknik sorularınız ve güncellemeleriniz için yanınızdayız.',
    icon: Headphones,
  },
];
---

<section class="py-20 bg-white border-b border-slate-200" id="neden-biz">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-sky-600 bg-sky-100/80 px-3 py-1 rounded-full border border-sky-200">
        Neden Bizimle Çalışmalısınız?
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 leading-tight">
        Tek bir hizmet değil, <span class="text-sky-600">çalışan bir dijital sistem</span> kuruyoruz.
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-3">
        İşletmenizin dijitaldeki gücünü artırmak için benimsediğimiz temel çalışma ilkelerimiz.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        whyUsCards.map((card) => {
          const IconComp = card.icon;
          return (
            <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200 hover:border-sky-300 hover:bg-sky-50/40 transition-all shadow-xs group">
              <div class="p-3.5 rounded-xl bg-sky-500 text-white w-fit mb-6 shadow-xs group-hover:scale-110 transition-transform">
                <IconComp className="w-6 h-6" />
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">{card.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{card.desc}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
