---
import { HelpCircle, ChevronDown } from 'lucide-react';

const faqs = [
  {
    q: 'Web sitesi ne kadar sürede hazırlanır?',
    a: 'Projenin kapsamına bağlı olarak standart kurumsal web siteleri ortalama 7-14 iş günü içinde teslim edilir. Kapsamlı özel yazılımlar ve entegrasyonlu projelerde süre ihtiyaç analizine göre belirlenir.',
  },
  {
    q: 'Web sitesi fiyatları neye göre belirlenir?',
    a: 'Fiyatlar sayfa sayısı, özel tasarım gereksinimleri, içerik hazırlığı, mobil uyumluluk ve ekstra entegrasyon (WhatsApp teklif formu, çoklu dil, SEO yapılandırması) detaylarına göre şeffaf şekilde hesaplanır.',
  },
  {
    q: 'Domain ve hosting hizmete dahil mi?',
    a: 'Domain (alan adı) ve hosting (sunucu) alanlarında müşterilerimizin kendi hesaplarını kullanmalarını veya tarafımızdan kurulum desteği almalarını sağlıyoruz. Vercel gibi ücretsiz statik barındırma çözümlerinde hosting maliyeti oluşmaz.',
  },
  {
    q: 'SEO çalışmaları ne zaman sonuç verir?',
    a: 'SEO uzun soluklu bir süreçtir. Teknik alt yapı düzeltmeleri ve site içi SEO çalışmaları yayına alındıktan sonra 1-3 ay içerisinde arama motoru indekslerinde belirgin artışlar gözlemlenmeye başlar.',
  },
  {
    q: 'Google Maps’te kesin üst sıra garantisi veriliyor mu?',
    a: 'Arama motorlarının ve harita algoritmalarının resmî yayıncısı hariç kimse %100 sıra garantisi veremez. Biz Google İşletme Profilinizi tüm yerel SEO ve kategori standartlarına eksiksiz uyarlayarak görünürlüğünüzü en üst seviyeye çıkarıyoruz.',
  },
  {
    q: 'Yemeksepeti ve Trendyol Yemek panellerini siz mi yönetiyorsunuz?',
    a: 'Süreç başında panel başvurularınızı, mağaza kurulumunuzu, menü yapılandırmanızı ve kampanya ayarlarınızı eksiksiz yapıyoruz. Ardından panel kullanım eğitimi sunarak operasyonu kolayca yönetmenizi sağlıyoruz.',
  },
  {
    q: 'Instagram reklam bütçesi hizmet ücretine dahil mi?',
    a: 'Hayır. Reklam yayınlama bütçeniz doğrudan Meta (Instagram/Facebook) hesabınıza yüklenir ve doğrudan platforma ödenir. Ajansımız hedef kitle, görsel kurgu ve kampanya yönetimi hizmeti sunar.',
  },
  {
    q: 'Mobil uygulama hem iOS hem Android için hazırlanabilir mi?',
    a: 'Evet. Cross-platform teknolojiler sayesinde tek bir kod tabanı üzerinden hem Apple App Store hem de Google Play Store ile tam uyumlu performanslı mobil uygulamalar geliştiriyoruz.',
  },
  {
    q: 'Yayınlama sonrasında teknik destek veriliyor mu?',
    a: 'Evet. Tüm projelerimizde yayına alma sonrasında 30 gün boyunca ücretsiz teknik destek ve soru-cevap danışmanlığı sağlıyoruz. Arzu eden müşterilerimizle yıllık bakım anlaşmaları da yapmaktayız.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<section class="py-20 bg-slate-50 border-b border-slate-200" id="faq">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100/80 text-sky-700 text-xs font-bold uppercase tracking-wider mb-3">
        <HelpCircle className="w-4 h-4 text-sky-600" />
        <span>Sık Sorulan Sorular</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
        Aklınıza takılan soruların yanıtları
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Hizmetlerimiz ve çalışma yöntemimiz hakkında en çok merak edilen konular.
      </p>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="group p-5 rounded-xl bg-white border border-slate-200 shadow-xs hover:border-sky-300 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base sm:text-lg focus:outline-none">
              <span class="pr-4">{faq.q}</span>
              <ChevronDown className="w-5 h-5 text-sky-500 shrink-0 group-open:rotate-180 transition-transform duration-200" />
            </summary>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQPage Schema.org JSON-LD -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
