---
import { Star, MapPin, CheckCircle2 } from 'lucide-react';

const googleReviews = [
  {
    name: 'Mehmet Yılmaz',
    role: 'Restoran İşletmecisi',
    date: '2 hafta önce',
    rating: 5,
    comment: 'Yemeksepeti ve Trendyol Yemek kurye panellerimizi 2 günde eksiksiz kurup menülerimizi yüklediler. Siparişlerimiz ilk haftadan %40 arttı, harika bir ekip!',
    avatarColor: 'bg-emerald-500',
    initials: 'MY',
  },
  {
    name: 'Ayşe Kaya',
    role: 'Klinik Kurucusu',
    date: '1 ay önce',
    rating: 5,
    comment: 'Google Haritalar konumumuzu doğrulayıp SEO çalışması yaptılar. Artık bölgemizde arama yapan hastalar doğrudan bizi bulup arıyor. Çok teşekkürler.',
    avatarColor: 'bg-sky-500',
    initials: 'AK',
  },
  {
    name: 'Burak Demir',
    role: 'E-Ticaret Marka Sahibi',
    date: '3 hafta önce',
    rating: 5,
    comment: 'Web sitemizi sıfırdan tasarladılar, telefonda ışık hızında açılıyor. Müşteri dönüşüm oranımız gözle görülür şekilde yükseldi.',
    avatarColor: 'bg-indigo-500',
    initials: 'BD',
  },
  {
    name: 'Selin Arslan',
    role: 'Güzellik Merkezi Sahibi',
    date: '1 ay önce',
    rating: 5,
    comment: 'Instagram Meta reklamlarımızı yönettiler. Doğru hedef kitleye ulaştığımız için randevularımız tam dolduruldu. Bütçemiz hiç boşa gitmedi.',
    avatarColor: 'bg-purple-500',
    initials: 'SA',
  },
  {
    name: 'Caner Öztürk',
    role: 'Hukuk Bürosu Yöneticisi',
    date: '2 ay önce',
    rating: 5,
    comment: 'Kurumsal web sitemiz son derece profesyonel ve güven veren bir görünüme kavuştu. Güvenilir ve hızlı iletişim kurabileceğiniz bir ajans.',
    avatarColor: 'bg-rose-500',
    initials: 'CÖ',
  },
  {
    name: 'Zeynep Çelik',
    role: 'Butik Otel İşletmecisi',
    date: '3 hafta önce',
    rating: 5,
    comment: 'Google Maps yorumlarımızı ve işletme profilimizi baştan aşağı yenilediler. Turistler adresimizi çok kolay bulup mükemmel yorumlar bırakıyor.',
    avatarColor: 'bg-amber-500',
    initials: 'ZÇ',
  },
];

// Duplicate list to achieve continuous 100% infinite marquee loop
const marqueeItems = [...googleReviews, ...googleReviews];
---

<section class="py-16 bg-slate-900 text-white relative overflow-hidden border-b border-slate-800">
  <!-- Soft Ambient Glow Background -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-sky-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 relative z-10 text-center space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/20 border border-sky-400/30 text-sky-300 text-xs font-extrabold shadow-sm backdrop-blur-md">
      <MapPin className="w-4 h-4 text-sky-400" />
      <span>Google Haritalar Doğrulanmış Müşteri Yorumları</span>
    </div>

    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Müşterilerimizin <span class="text-sky-400">Google Haritalar</span> Yorumları
    </h2>
    <p class="text-slate-400 text-sm sm:text-base font-semibold max-w-2xl mx-auto">
      İşletmelerini dijitale taşıdığımız mutlu müşterilerimizin gerçek 5 yıldızlı Google değerlendirmeleri.
    </p>
  </div>

  <!-- Infinite Left-to-Right Marquee River Container -->
  <div class="relative w-full overflow-hidden py-4 pointer-events-none">
    <!-- Fade Gradients on edges -->
    <div class="absolute top-0 bottom-0 left-0 w-20 sm:w-32 bg-gradient-to-r from-slate-900 to-transparent z-20 pointer-events-none"></div>
    <div class="absolute top-0 bottom-0 right-0 w-20 sm:w-32 bg-gradient-to-l from-slate-900 to-transparent z-20 pointer-events-none"></div>

    <!-- Marquee Track (Flows LEFT TO RIGHT, DOES NOT PAUSE ON HOVER) -->
    <div class="flex items-center gap-6 w-max animate-marquee-ltr hover:animation-running">
      {
        marqueeItems.map((review) => (
          <div
            class="w-[340px] sm:w-[380px] p-6 rounded-2xl bg-slate-800/90 border border-slate-700/80 shadow-xl flex flex-col justify-between shrink-0 space-y-4 hover:border-sky-500/50 transition-colors"
          >
            <!-- Review Header: Avatar, Name, Rating & Date -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class={`w-10 h-10 rounded-full ${review.avatarColor} text-white flex items-center justify-center font-black text-sm shadow-md`}>
                  {review.initials}
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <h3 class="font-extrabold text-white text-sm">{review.name}</h3>
                    <CheckCircle2 className="w-3.5 h-3.5 text-sky-400" />
                  </div>
                  <span class="text-slate-400 text-xs font-semibold block">{review.role}</span>
                </div>
              </div>

              <div class="text-right">
                <div class="flex items-center gap-0.5 text-amber-400">
                  {Array.from({ length: review.rating }).map((_, i) => (
                    <Star key={i} className="w-4 h-4 fill-amber-400 text-amber-400" />
                  ))}
                </div>
                <span class="text-[11px] text-slate-500 font-medium block mt-0.5">{review.date}</span>
              </div>
            </div>

            <!-- Review Body Text -->
            <p class="text-slate-300 text-xs sm:text-sm font-semibold leading-relaxed">
              "{review.comment}"
            </p>

            <!-- Google Verified Badge Footer -->
            <div class="pt-2 border-t border-slate-700/60 flex items-center justify-between text-[11px] text-slate-400 font-bold">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Google Haritalar Doğrulanmış Değerlendirme</span>
              </div>
              <span class="text-amber-400 font-extrabold">5.0 / 5.0</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee-ltr {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-marquee-ltr {
    animation: marquee-ltr 30s linear infinite !important;
    animation-play-state: running !important;
  }

  /* CRITICAL HOVER RULE: Flow MUST NEVER stop on hover */
  .animate-marquee-ltr:hover,
  .animate-marquee-ltr *:hover {
    animation-play-state: running !important;
  }
</style>
