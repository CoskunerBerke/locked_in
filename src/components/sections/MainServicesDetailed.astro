---
import { Globe, Smartphone, Search, MapPin, Utensils, Megaphone, CheckCircle, ArrowRight } from 'lucide-react';

const detailedServices = [
  {
    id: 'web-tasarim',
    badge: 'Web Çözümleri',
    title: 'Web Tasarım ve Özel Geliştirme',
    subtitle: 'Hızlı, mobil öncelikli ve yüksek dönüşüm odaklı kurumsal web siteleri.',
    desc: 'Markanızın dijital vitrinini en yüksek hız ve güvenlik standartlarında inşa ediyoruz. Şablon kalıplardan uzak, işletmenize özel tasarlanan web sitelerimiz Vercel ve klasik FTP/hosting ortamlarıyla %100 uyumludur.',
    features: [
      'Kurumsal Web Sitesi & Landing Page Tasarımı',
      'Mobil Öncelikli & Dönüşüm Odaklı UI/UX',
      'Teknik SEO & Core Web Vitals Hız Optimizasyonu',
      'Statik Mimari ile Maximum Güvenlik & 0 Zafiyet',
    ],
    ctaText: 'Web Tasarım Hizmetini İncele',
    ctaHref: '/hizmetler/web-sitesi-tasarimi/',
    icon: Globe,
    visualBg: 'from-sky-50 to-slate-100',
    alignLeft: true,
  },
  {
    id: 'mobil-uygulama',
    badge: 'Yazılım Çözümleri',
    title: 'Mobil Uygulama & Özel Web Yazılım',
    subtitle: 'iOS ve Android platformlarında performanslı mobil ürünler.',
    desc: 'Fikrinizi kullanıcı dostu iOS ve Android uygulamalarına dönüştürüyoruz. API entegrasyonları, performans testleri ve mağaza yayınlama süreçlerini uçtan uca tamamlıyoruz.',
    features: [
      'Cross-Platform iOS & Android Geliştirme',
      'Özel Yönetim Paneli & API Entegrasyonları',
      'Mağaza (App Store / Play Store) Yayınlama Desteği',
      'Yayın Sonrası Performans & Güncelleme Takibi',
    ],
    ctaText: 'Mobil Uygulama Hizmetini İncele',
    ctaHref: '/hizmetler/mobil-uygulama/',
    icon: Smartphone,
    visualBg: 'from-indigo-50 to-slate-100',
    alignLeft: false,
  },
  {
    id: 'seo',
    badge: 'Arama Motoru Görünürlüğü',
    title: 'SEO ve Web Görünürlüğü',
    subtitle: 'Organik aramalarda üst sıralara tırmanan teknik ve içerik altyapısı.',
    desc: 'Web sitenizi arama motorlarının tam olarak anladığı standartlara getiriyoruz. Şeffaf teknik analizler, site içi SEO iyileştirmeleri ve ölçülebilir Search Console takibiyle görünürlüğünüzü artırıyoruz.',
    features: [
      'Detaylı Teknik SEO Audit & Core Web Vitals',
      'Site İçi SEO & Semantik Schema.org Yapılandırması',
      'Sitemap & Robots.txt Otomasyonu',
      'Şeffaf İlerleme & Search Console Raporlaması',
    ],
    ctaText: 'SEO Hizmetini İncele',
    ctaHref: '/hizmetler/seo/',
    icon: Search,
    visualBg: 'from-emerald-50 to-slate-100',
    alignLeft: true,
  },
  {
    id: 'google-maps',
    badge: 'Yerel Görünürlük',
    title: 'Google Maps ve Yerel SEO',
    subtitle: 'Müşterilerinizin konumunuza ve hizmetlerinize kolayca ulaşmasını sağlayın.',
    desc: 'Google Business Profile hesabınızı eksiksiz yapılandırıyor, hizmet kategorilerinizi düzenliyor ve bölgesel aramalarda harita üst sıralarında yer almanız için gerekli yerel sinyalleri kuruyoruz.',
    features: [
      'Google İşletme Profili Kurulum & Doğrulama',
      'Kategori, Fotoğraf ve Hizmet Alanı Düzenleme',
      'Konum Tutarlılığı & Müşteri Yorum Süreçleri',
      'Bölgesel Arama Görünürlüğü İyileştirmeleri',
    ],
    ctaText: 'Google Maps Hizmetini İncele',
    ctaHref: '/hizmetler/google-maps/',
    icon: MapPin,
    visualBg: 'from-amber-50 to-slate-100',
    alignLeft: false,
  },
  {
    id: 'yemek-platformlari',
    badge: 'Yemek İşletmeleri',
    title: 'Yemeksepeti ve Trendyol Yemek Kurulumu',
    subtitle: 'Restoran ve kafeler için profesyonel dijital menü ve panel operasyonları.',
    desc: 'Yemeksepeti ve Trendyol Yemek panellerinizi sıfırdan kurulum yapıyor, menü kategorilerinizi, ürün görsellerinizi ve kampanya ayarlarınızı satış odaklı olarak yapılandırıyoruz.',
    features: [
      'Panel Başvuru, Kurulum ve Doğrulama Desteği',
      'İştah Açıcı Menü & Kategori Organizasyonu',
      'Fiyat, Varyasyon & Kampanya Kurulumları',
      'Çalışma Saatleri & Panel Kullanım Danışmanlığı',
    ],
    ctaText: 'Yemek Platformu Hizmetini İncele',
    ctaHref: '/hizmetler/yemeksepeti-trendyol-yemek/',
    icon: Utensils,
    visualBg: 'from-rose-50 to-slate-100',
    alignLeft: true,
  },
  {
    id: 'instagram-reklamlari',
    badge: 'Sosyal Medya Reklamı',
    title: 'Instagram ve Meta Reklam Yönetimi',
    subtitle: 'Doğru hedef kitleye ulaşan, ölçülebilir ve verimli reklam kampanyaları.',
    desc: 'Sosyal medyada bütçenizi boşa harcamadan doğru müşterilere ulaşmanızı sağlıyoruz. Hedef kitle analizinden reklam görseli hazırlamaya ve bütçe optimizasyonuna kadar tüm süreçleri yönetiyoruz.',
    features: [
      'Demografik & İlgi Alanı Hedef Kitle Analizi',
      'Meta Business Suite & Pixel Kurulumu',
      'Reklam Metni & Görsel Tasarım Desteği',
      'Haftalık Bütçe & Dönüşüm Optimizasyonu',
    ],
    ctaText: 'Instagram Reklam Hizmetini İncele',
    ctaHref: '/hizmetler/instagram-reklamlari/',
    icon: Megaphone,
    visualBg: 'from-purple-50 to-slate-100',
    alignLeft: false,
  },
];
---

<section class="py-20 bg-slate-50 border-b border-slate-200" id="hizmetlerimiz">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-widest text-sky-600 bg-sky-100/80 px-3 py-1 rounded-full border border-sky-200">
        Kapsamlı Hizmet Kataloğumuz
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 leading-tight">
        İşletmenizi dijitalde büyütecek uçtan uca uzmanlık alanlarımız
      </h2>
      <p class="text-slate-600 text-base mt-3">
        Aşağıdaki her hizmet, dijital varlığınızı güçlendirmek ve sürdürülebilir başarı yakalamanız için özel olarak kurgulanmıştır.
      </p>
    </div>

    {
      detailedServices.map((service) => {
        const IconComp = service.icon;
        return (
          <div
            id={service.id}
            class={`grid grid-cols-1 lg:grid-cols-12 gap-10 items-center p-8 sm:p-12 rounded-2xl bg-white border border-slate-200 shadow-sm ${
              service.alignLeft ? '' : ''
            }`}
          >
            {/* Text Side */}
            <div class={`space-y-5 lg:col-span-7 ${service.alignLeft ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-sky-50 text-sky-700 font-bold text-xs">
                <IconComp className="w-4 h-4 text-sky-600" />
                <span>{service.badge}</span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                {service.title}
              </h3>

              <p class="text-sm font-semibold text-sky-600">{service.subtitle}</p>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">{service.desc}</p>

              <ul class="space-y-2.5 pt-2">
                {service.features.map((feat) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 font-medium">
                    <CheckCircle className="w-4 h-4 text-sky-500 shrink-0 mt-0.5" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-4">
                <a href={service.ctaHref} class="btn-primary text-xs sm:text-sm py-2.5 px-5">
                  <span>{service.ctaText}</span>
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>

            {/* Visual Side */}
            <div class={`lg:col-span-5 ${service.alignLeft ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class={`p-8 sm:p-12 rounded-xl bg-gradient-to-br ${service.visualBg} border border-slate-200 flex flex-col items-center justify-center text-center space-y-4 shadow-inner min-h-[260px]`}>
                <div class="p-4 rounded-2xl bg-white text-sky-600 shadow-md">
                  <IconComp className="w-10 h-10" />
                </div>
                <h4 class="font-bold text-slate-900 text-lg">{service.title}</h4>
                <span class="text-xs text-slate-500 font-medium">Locked_in Dijital Standartları</span>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
