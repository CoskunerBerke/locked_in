---
const tickerItems = [
  { label: 'Web Tasarımı ve Geliştirme', icon: 'code' },
  { label: 'Mobil Uygulama', icon: 'smartphone' },
  { label: 'Teknik ve Site İçi SEO', icon: 'search' },
  { label: 'Google Maps ve Yerel SEO', icon: 'map-pin' },
  { label: 'Yemek Platformları Yönetimi', icon: 'shopping-bag' },
  { label: 'Instagram ve Meta Reklamları', icon: 'trending-up' },
];
---

<section class="py-6 bg-white border-b border-slate-200/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between flex-wrap gap-4 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">
      <span>Uzmanlık Alanlarımız</span>
      <span class="text-sky-600 font-bold">Uçtan Uca Dijital Yönetim</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {
        tickerItems.map((item) => (
          <div class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-slate-800 font-medium text-xs hover:border-sky-300 hover:bg-sky-50/50 transition-all">
            <span class="w-2 h-2 rounded-full bg-sky-500 shrink-0" />
            <span class="truncate">{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
