---
import { Globe, Code, Smartphone, Search, MapPin, Utensils, Megaphone, ArrowUpRight } from 'lucide-react';

const serviceStrips = [
  { title: 'Web Tasarım', href: '/hizmetler/web-sitesi-tasarimi/', icon: Globe },
  { title: 'Web Yazılım', href: '/hizmetler/mobil-uygulama/', icon: Code },
  { title: 'Mobil Uygulama', href: '/hizmetler/mobil-uygulama/', icon: Smartphone },
  { title: 'SEO Hizmetleri', href: '/hizmetler/seo/', icon: Search },
  { title: 'Google Maps', href: '/hizmetler/google-maps/', icon: MapPin },
  { title: 'Yemek Platformları', href: '/hizmetler/yemeksepeti-trendyol-yemek/', icon: Utensils },
  { title: 'Instagram Reklamları', href: '/hizmetler/instagram-reklamlari/', icon: Megaphone },
];
---

<section id="hizmetler-listesi" class="bg-white border-b border-slate-200 py-6 px-4 sm:px-6 lg:px-8 shadow-sm">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between gap-4 overflow-x-auto scrollbar-none py-1">
      {
        serviceStrips.map((item) => {
          const IconComp = item.icon;
          return (
            <a
              href={item.href}
              class="flex items-center gap-2.5 px-4 py-3 rounded-xl bg-slate-50 hover:bg-sky-50 border border-slate-200 hover:border-sky-300 text-slate-800 hover:text-sky-600 font-semibold text-xs sm:text-sm shrink-0 transition-all group shadow-2xs"
            >
              <IconComp className="w-4 h-4 text-sky-500 group-hover:scale-110 transition-transform" />
              <span>{item.title}</span>
              <ArrowUpRight className="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-600 transition-colors" />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
