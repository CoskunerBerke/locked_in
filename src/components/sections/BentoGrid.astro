---
const services = [
  {
    id: 'web-sitesi',
    title: 'Web Sitesi Tasarımı ve Geliştirme',
    subtitle: 'Kurumsal Web Sitesi & Landing Page',
    description: 'Hızlı, mobil öncelikli, SEO dostu ve dönüşüm odaklı web siteleri ile dijitaldeki prestijinizi artırıyoruz.',
    link: '/hizmetler/web-sitesi-tasarimi/',
    badge: 'Kurumsal & Landing',
    gridClass: 'lg:col-span-2',
    gradient: 'from-sky-50 to-indigo-50/40',
    iconColor: 'text-sky-600',
  },
  {
    id: 'seo',
    title: 'SEO ve Web Görünürlüğü',
    subtitle: 'Teknik, Site İçi & Yerel SEO',
    description: 'Arama motorlarında teknik altyapınızı güçlendirerek web sitenizin organik erişimini ve performansını iyileştiriyoruz.',
    link: '/hizmetler/seo/',
    badge: 'Organik Büyüme',
    gridClass: 'lg:col-span-1',
    gradient: 'from-indigo-50/50 to-sky-50/30',
    iconColor: 'text-indigo-600',
  },
  {
    id: 'yemek-platformlari',
    title: 'Yemeksepeti ve Trendyol Yemek Yönetimi',
    subtitle: 'Panel Kurulumu & Menü Operasyonları',
    description: 'Restoranınızın yemek platformlarındaki mağaza kurulumunu, menü, kategori, fiyat ve çalışma saati düzenlemelerini yönetiyoruz.',
    link: '/hizmetler/yemeksepeti-trendyol-yemek/',
    badge: 'Restoran Danışmanlığı',
    gridClass: 'lg:col-span-1',
    gradient: 'from-amber-50/50 to-orange-50/30',
    iconColor: 'text-amber-600',
  },
  {
    id: 'mobil-uygulama',
    title: 'Mobil Uygulama Geliştirme',
    subtitle: 'iOS & Android Çözümleri',
    description: 'İşletmenizin müşterileriyle doğrudan etkileşime geçebileceği modern, performanslı mobil uygulamalar tasarlıyoruz.',
    link: '/hizmetler/mobil-uygulama/',
    badge: 'iOS & Android',
    gridClass: 'lg:col-span-1',
    gradient: 'from-blue-50/50 to-cyan-50/30',
    iconColor: 'text-blue-600',
  },
  {
    id: 'google-maps',
    title: 'Google Maps ve Yerel SEO',
    subtitle: 'Harita & İşletme Profil Optimizasyonu',
    description: 'Fiziksel işletmenizin Google Haritalar üzerindeki görünürlüğünü ve müşteri etkileşimini artıracak stratejiler sunuyoruz.',
    link: '/hizmetler/google-maps/',
    badge: 'Yerel Görünürlük',
    gridClass: 'lg:col-span-1',
    gradient: 'from-emerald-50/50 to-teal-50/30',
    iconColor: 'text-emerald-600',
  },
  {
    id: 'instagram-reklamlari',
    title: 'Instagram ve Meta Reklamları',
    subtitle: 'Reklam Yayınlama & Performans Takibi',
    description: 'Hedef kitlenize ulaşan görsel ve video içerikli sosyal medya reklamları hazırlıyor, bütçenizin performansını anlık izliyoruz.',
    link: '/hizmetler/instagram-reklamlari/',
    badge: 'Performans Pazarlama',
    gridClass: 'lg:col-span-2',
    gradient: 'from-purple-50/40 to-sky-50/40',
    iconColor: 'text-purple-600',
  },
];
---

<section id="hizmetler" class="py-24 bg-slate-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="badge-primary mb-3">Hizmet Yelpazemiz</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        İşletmeniz İçin Uçtan Uca Dijital Hizmetler
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Tüm dijital kanallardaki varlığınızı tek bir profesyonel ekipten yönetin.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service) => (
          <div
            class={`glass-card rounded-2xl p-8 flex flex-col justify-between relative overflow-hidden group bg-gradient-to-br ${service.gradient} ${service.gridClass}`}
          >
            <!-- Card Content -->
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/80 text-slate-700 border border-slate-200/80 shadow-xs">
                  {service.badge}
                </span>

                <div class={`p-3 rounded-xl bg-white shadow-xs ${service.iconColor}`}>
                  {service.id === 'web-sitesi' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                  {service.id === 'seo' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                  )}
                  {service.id === 'yemek-platformlari' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                  )}
                  {service.id === 'mobil-uygulama' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  )}
                  {service.id === 'google-maps' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                  )}
                  {service.id === 'instagram-reklamlari' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                  )}
                </div>
              </div>

              <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-sky-600 transition-colors">
                {service.title}
              </h3>
              <p class="text-xs font-medium text-sky-700 mb-3">{service.subtitle}</p>
              <p class="text-sm text-slate-600 leading-relaxed mb-6">
                {service.description}
              </p>
            </div>

            <!-- Detail Link Button -->
            <div class="pt-4 border-t border-slate-200/60">
              <a
                href={service.link}
                class="inline-flex items-center gap-2 text-sm font-semibold text-sky-600 hover:text-sky-700 focus:outline-none focus:underline"
              >
                <span>Detayları İncele</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
