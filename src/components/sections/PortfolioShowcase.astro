---
import projectsData from '../../data/projects';
import { ExternalLink, ArrowRight, CheckCircle2 } from 'lucide-react';
---

<section class="py-20 bg-slate-900 text-white relative overflow-hidden border-t border-slate-800" id="portfolyo-section">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-bold uppercase tracking-wider">
        <span>Yaptıklarımız &amp; Canlı Referanslarımız</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Hayata Geçirdiğimiz Başarılı Dijital Projeler
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        Farklı sektörlerdeki müşterilerimiz için tasarladığımız ve yayınladığımız canlı web platformlarından öne çıkan projeler.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projectsData.map((project) => (
          <div class="group rounded-2xl bg-slate-800/80 border border-slate-700/80 overflow-hidden hover:border-sky-400/60 transition-all duration-300 shadow-xl hover:shadow-2xl hover:shadow-sky-500/10 flex flex-col justify-between">
            {/* Card Visual Header */}
            <div class="relative overflow-hidden aspect-video bg-slate-950">
              <img
                src={project.image}
                alt={`${project.title} Web Sitesi Ekran Görüntüsü`}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="640"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80"></div>
              
              {/* Category Pill */}
              <div class="absolute top-4 left-4 z-10">
                <span class="px-3 py-1 rounded-full bg-slate-900/90 backdrop-blur-md border border-slate-700 text-sky-400 text-xs font-bold">
                  {project.industry}
                </span>
              </div>
            </div>

            {/* Content Body */}
            <div class="p-6 space-y-4 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <h3 class="text-xl font-extrabold text-white group-hover:text-sky-300 transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs text-slate-300 leading-relaxed">
                  {project.description}
                </p>
              </div>

              {/* Service Badges */}
              <div class="flex flex-wrap gap-2 pt-2">
                {project.services.map((service) => (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-slate-700/50 text-slate-300 text-[11px] font-medium">
                    <CheckCircle2 className="w-3 h-3 text-sky-400" />
                    {service}
                  </span>
                ))}
              </div>

              {/* Action Button */}
              <div class="pt-4 border-t border-slate-700/60 flex items-center justify-between">
                <span class="text-xs text-slate-400 font-mono">{project.liveUrl.replace('https://', '').replace('http://', '').replace(/\/$/, '')}</span>
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs transition-all shadow-md group/btn"
                  aria-label={`${project.title} canlı web sitesini incele`}
                >
                  <span>Siteyi İncele</span>
                  <ExternalLink className="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Footer CTA Link -->
    <div class="text-center pt-4">
      <a
        href="/projeler/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold text-sm transition-all shadow-md"
      >
        <span>Tüm Referans Projelerimizi Görün</span>
        <ArrowRight className="w-4 h-4 text-sky-400" />
      </a>
    </div>
  </div>
</section>
