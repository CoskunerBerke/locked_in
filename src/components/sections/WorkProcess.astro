---
import { Search, Compass, FileText, Layout, Code, CheckCircle, Rocket } from 'lucide-react';

const processSteps = [
  {
    step: '01',
    title: 'İhtiyaç Analizi',
    desc: 'İşletmenizin hedeflerini, beklentilerini ve bütçe çerçevesini detaylı görüşmelerle belirliyoruz.',
    icon: Search,
  },
  {
    step: '02',
    title: 'Rakip & Sektör Araştırması',
    desc: 'Sektörünüzdeki en güçlü rakipleri inceleyerek dijitalde sizi öne geçirecek stratejiyi oluşturuyoruz.',
    icon: Compass,
  },
  {
    step: '03',
    title: 'İçerik & Site Haritası',
    desc: 'Kullanıcıların ve arama motorlarının kolayca gezinebileceği mantıksal içerik hiyerarşisini planlıyoruz.',
    icon: FileText,
  },
  {
    step: '04',
    title: 'UI/UX Tasarımı',
    desc: 'Markanıza özel, dönüşüm odaklı ve tüm cihazlarda kusursuz görünen arayüz tasarımlarını hazırlıyoruz.',
    icon: Layout,
  },
  {
    step: '05',
    title: 'Yazılım & Entegrasyon',
    desc: 'Tasarımı temiz HTML5/React kodlarına dönüştürüp gerekli API ve sistem entegrasyonlarını kodluyoruz.',
    icon: Code,
  },
  {
    step: '06',
    title: 'Test & Optimizasyon',
    desc: 'Hız, güvenlik, erişilebilirlik ve tüm cihaz uyumluluk testlerini Playwright ile otomatik doğruluyoruz.',
    icon: CheckCircle,
  },
  {
    step: '07',
    title: 'Yayınlama & Destek',
    desc: 'Projenizi Vercel veya sunucunuza sorunsuz canlıya alıyor, yayın sonrası teknik desteği başlatıyoruz.',
    icon: Rocket,
  },
];
---

<section class="py-20 bg-slate-50 border-b border-slate-200" id="surec">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-sky-600 bg-sky-100/80 px-3 py-1 rounded-full border border-sky-200">
        Şeffaf İlerleme Modeli
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 leading-tight">
        7 Adımda Fikirden Başarılı Dijital Yayına
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-3">
        Tüm projelerimizi önceden belirlenmiş şeffaf aşamalarla zamanında ve eksiksiz teslim ediyoruz.
      </p>
    </div>

    <!-- Process Timeline Desktop & Steps Mobile -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-7 gap-4">
      {
        processSteps.map((item) => {
          const IconComp = item.icon;
          return (
            <div class="relative p-5 rounded-xl bg-white border border-slate-200 shadow-xs flex flex-col justify-between hover:border-sky-300 hover:shadow-md transition-all group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-2xl font-black text-sky-500/30 group-hover:text-sky-600 transition-colors">
                    {item.step}
                  </span>
                  <div class="p-2 rounded-lg bg-sky-50 text-sky-600 group-hover:bg-sky-500 group-hover:text-white transition-colors">
                    <IconComp className="w-4 h-4" />
                  </div>
                </div>
                <h3 class="font-bold text-slate-900 text-sm mb-2">{item.title}</h3>
                <p class="text-xs text-slate-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
