---
const steps = [
  {
    step: '01',
    title: 'Dinliyoruz',
    desc: 'İşletmenizin mevcut durumunu, dijitaldeki eksiklerini ve hedeflerini detaylıca analiz ediyoruz.',
    badge: 'Analiz & Keşif',
  },
  {
    step: '02',
    title: 'Planlıyoruz',
    desc: 'Bütçenize ve sektörünüze özel uçtan uca dijital büyüme stratejisi ve süreç takvimi hazırlıyoruz.',
    badge: 'Strateji & Mimari',
  },
  {
    step: '03',
    title: 'Üretiyor ve Kuruyoruz',
    desc: 'Web sitesi, mobil uygulama, harita kaydı, sosyal medya ve yemek panellerinizi eksiksiz yayına alıyoruz.',
    badge: 'Kurulum & Yayın',
  },
  {
    step: '04',
    title: 'Ölçüyor ve Geliştiriyoruz',
    desc: 'Performans verilerini sürekli takip ederek reklam ve SEO stratejilerinizi düzenli olarak optimize ediyoruz.',
    badge: 'Takip & Büyüme',
  },
];
---

<section id="surec" class="py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="badge-primary mb-3">Çalışma Metodolojimiz</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        4 Adımda Dijital Büyüme Süreci
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Şeffaf, öngörülebilir ve sonuç odaklı çalışma prensibimizle her adımı sizinle paylaşıyoruz.
      </p>
    </div>

    <!-- Desktop Stepped Sequence & Mobile Vertical List -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
      {
        steps.map((item, index) => (
          <div class="glass-card rounded-2xl p-6 relative flex flex-col justify-between group hover:border-sky-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-sky-600/30 group-hover:text-sky-600 transition-colors">
                  {item.step}
                </span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                  {item.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center text-xs font-medium text-sky-600">
              <span>Aşama {index + 1} / 4</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
