---
import ServicesSolarSystemCanvas from '../common/ServicesSolarSystemCanvas.react';
import { ArrowRight } from 'lucide-react';
---

<section class="relative min-h-[88vh] flex items-center justify-center overflow-hidden bg-gradient-to-b from-slate-50 via-sky-50/40 to-slate-100 border-b border-slate-200">
  
  <!-- Light Grid Pattern (Matching User Screenshot) -->
  <div 
    class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-70 z-0 pointer-events-none"
    aria-hidden="true"
  />

  <!-- Soft Glowing Translucent Sphere & Orbital Arcs -->
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 rounded-full bg-gradient-to-tr from-sky-400/20 via-sky-300/10 to-indigo-300/20 blur-2xl pointer-events-none z-0"></div>
  <div class="absolute top-1/3 right-1/3 w-[500px] h-[500px] rounded-full border border-sky-300/40 pointer-events-none z-0 animate-spin-slow"></div>

  <!-- Hero Content Grid -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: High-Contrast Sharp Text -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Main Headline H1 - High-Contrast Deep Dark Navy -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-[1.15]">
          İşletmenizi dijitalde<br class="hidden sm:inline" />
          <span class="text-sky-600 font-black">
            güçlü bir sisteme
          </span> dönüştürüyoruz.
        </h1>

        <!-- Subheading -->
        <p class="text-sm sm:text-base font-black text-sky-700 uppercase tracking-widest">
          TASARIM, YAZILIM VE BÜYÜME TEK EKİPTE.
        </p>

        <!-- Subtitle Description - Sharp Dark Slate -->
        <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-bold max-w-xl">
          Web sitesi ve mobil uygulama geliştirmeden SEO, Google Maps, sosyal medya reklamları ve yemek platformu yönetimine kadar işletmenizin ihtiyaç duyduğu dijital hizmetleri tek merkezden sunuyoruz.
        </p>

        <!-- Action CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a href="/iletisim/" class="btn-cta text-center shadow-xl font-black text-base py-3.5 px-7 bg-rose-600 hover:bg-rose-700 text-white border border-rose-500">
            <span>Ücretsiz Teklif Al</span>
            <ArrowRight className="w-5 h-5 ml-1" />
          </a>

          <a href="#hizmetlerimiz" class="bg-white hover:bg-slate-50 text-slate-900 border-2 border-slate-300 px-6 py-3.5 rounded-lg text-center font-extrabold text-sm transition-all shadow-md">
            <span>Hizmetlerimizi İncele</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive 8-Planet Animated Solar System Canvas with Dedicated Space Blue & Starlight Styling -->
      <div class="lg:col-span-6 relative">
        <div class="p-5 rounded-3xl bg-gradient-to-br from-[#0B1528] via-[#0F172A] to-[#020617] border border-sky-500/30 shadow-2xl shadow-sky-950/60 relative overflow-hidden group">
          
          <!-- Deep Space Cosmic Radial Glow & Starlight Background Effects -->
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(56,189,248,0.14),transparent_75%)] pointer-events-none"></div>
          <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-sky-500/10 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>

          <div class="text-center mb-3 relative z-20">
            <span class="text-[11px] font-black uppercase tracking-widest text-sky-300 bg-sky-950/80 px-4 py-1.5 rounded-full border border-sky-400/40 shadow-lg shadow-sky-950/50 backdrop-blur-md inline-block">
              Solar Sistem • 8 Hizmetimiz Döner Yörüngede
            </span>
          </div>

          <!-- Solar System Interactive Canvas -->
          <ServicesSolarSystemCanvas client:load />
        </div>
      </div>

    </div>
  </div>
</section>
