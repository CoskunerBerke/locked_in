---
import brandConfig from '../../config/brand';
import { Phone, Mail, Instagram, MessageCircle, MapPin } from 'lucide-react';

const isPhoneValid = brandConfig.phone && !brandConfig.phone.includes('Geçici');
const isEmailValid = brandConfig.email && !brandConfig.email.includes('Geçici');
const isInstagramValid = brandConfig.instagramUrl && !brandConfig.instagramUrl.includes('gecici');
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Column 1: Kurumsal & Brand -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img
            src={brandConfig.logoPath}
            alt={`${brandConfig.brandName} Logosu`}
            class="h-28 sm:h-36 lg:h-44 w-auto max-w-full brightness-200 object-contain object-left origin-left"
            width="320"
            height="160"
          />
        </a>
        <p class="text-slate-400 leading-relaxed text-xs">
          {brandConfig.description}
        </p>
        <ul class="space-y-2 pt-2">
          <li><a href="/hakkimizda/" class="hover:text-white transition-colors">Hakkımızda</a></li>
          <li><a href="/#surec" class="hover:text-white transition-colors">Çalışma Süreci</a></li>
          <li><a href="/projeler/" class="hover:text-white transition-colors">Projelerimiz</a></li>
          <li><a href="/akademi/" class="hover:text-white transition-colors">Akademi / Blog</a></li>
          <li><a href="/iletisim/" class="hover:text-white transition-colors">İletişim</a></li>
        </ul>
      </div>

      <!-- Column 2: Web ve Yazılım -->
      <div class="space-y-3">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">Web &amp; Yazılım</h3>
        <ul class="space-y-2">
          <li><a href="/hizmetler/web-sitesi-tasarimi/" class="hover:text-white transition-colors">Kurumsal Web Sitesi</a></li>
          <li><a href="/hizmetler/web-sitesi-tasarimi/" class="hover:text-white transition-colors">Landing Page Tasarımı</a></li>
          <li><a href="/hizmetler/mobil-uygulama/" class="hover:text-white transition-colors">Mobil Uygulama (iOS &amp; Android)</a></li>
          <li><a href="/hizmetler/mobil-uygulama/" class="hover:text-white transition-colors">Özel Web Yazılım</a></li>
          <li><a href="/hizmetler/web-sitesi-tasarimi/" class="hover:text-white transition-colors">Teknik Bakım ve Destek</a></li>
        </ul>
      </div>

      <!-- Column 3: Dijital Görünürlük -->
      <div class="space-y-3">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">Dijital Görünürlük</h3>
        <ul class="space-y-2">
          <li><a href="/hizmetler/seo/" class="hover:text-white transition-colors">Teknik SEO</a></li>
          <li><a href="/hizmetler/seo/" class="hover:text-white transition-colors">Site İçi ve Yerel SEO</a></li>
          <li><a href="/hizmetler/google-maps/" class="hover:text-white transition-colors">Google Maps Optimizasyonu</a></li>
          <li><a href="/hizmetler/google-maps/" class="hover:text-white transition-colors">Google Business Profile</a></li>
          <li><a href="/hizmetler/instagram-reklamlari/" class="hover:text-white transition-colors">Instagram &amp; Meta Reklamları</a></li>
        </ul>
      </div>

      <!-- Column 4: Yemek İşletmeleri -->
      <div class="space-y-3">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">Yemek İşletmeleri</h3>
        <ul class="space-y-2">
          <li><a href="/hizmetler/yemeksepeti-trendyol-yemek/" class="hover:text-white transition-colors">Yemeksepeti Panel Kurulumu</a></li>
          <li><a href="/hizmetler/yemeksepeti-trendyol-yemek/" class="hover:text-white transition-colors">Trendyol Yemek Panel Kurulumu</a></li>
          <li><a href="/hizmetler/yemeksepeti-trendyol-yemek/" class="hover:text-white transition-colors">Menü ve Kategori Düzenleme</a></li>
          <li><a href="/hizmetler/yemeksepeti-trendyol-yemek/" class="hover:text-white transition-colors">Kampanya Yönetimi</a></li>
          <li><a href="/hizmetler/yemeksepeti-trendyol-yemek/" class="hover:text-white transition-colors">Panel Kullanım Danışmanlığı</a></li>
        </ul>
      </div>

      <!-- Column 5: İletişim Bilgileri -->
      <div class="space-y-3">
        <h3 class="font-bold text-white text-sm uppercase tracking-wider">İletişim &amp; Bölge</h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <MapPin className="w-4 h-4 text-sky-400 shrink-0" />
            <span>{brandConfig.serviceArea}</span>
          </li>

          {isPhoneValid && (
            <li class="flex items-center gap-2">
              <Phone className="w-4 h-4 text-sky-400 shrink-0" />
              <a href={`tel:${brandConfig.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-white transition-colors">
                {brandConfig.phone}
              </a>
            </li>
          )}

          {isEmailValid && (
            <li class="flex items-center gap-2">
              <Mail className="w-4 h-4 text-sky-400 shrink-0" />
              <a href={`mailto:${brandConfig.email}`} class="hover:text-white transition-colors">
                {brandConfig.email}
              </a>
            </li>
          )}

          <li class="flex items-center gap-2">
            <MessageCircle className="w-4 h-4 text-emerald-400 shrink-0" />
            <a
              href={`https://wa.me/${brandConfig.whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:underline"
            >
              WhatsApp Destek Hattı
            </a>
          </li>

          {isInstagramValid && (
            <li class="flex items-center gap-2">
              <Instagram className="w-4 h-4 text-sky-400 shrink-0" />
              <a href={brandConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                Instagram Hesabımız
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Sub-footer Legal Bar -->
    <div class="mt-16 pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between gap-4 text-slate-500 text-[11px]">
      <div class="space-y-1 text-center md:text-left">
        <p>© {new Date().getFullYear()} {brandConfig.legalCompanyName} Tüm hakları saklıdır.</p>
        <p class="text-slate-600">
          {brandConfig.brandName}, bağımsız bir dijital ajans ve teknoloji hizmet sağlayıcısıdır. Bahsi geçen üçüncü taraf platform markaları kendi hak sahiplerine aittir.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/gizlilik-politikasi/" class="hover:text-slate-300 transition-colors">Gizlilik Politikası</a>
        <span class="text-slate-800">•</span>
        <a href="/kvkk-aydinlatma-metni/" class="hover:text-slate-300 transition-colors">KVKK Aydınlatma Metni</a>
        <span class="text-slate-800">•</span>
        <a href="/kullanim-kosullari/" class="hover:text-slate-300 transition-colors">Kullanım Koşulları</a>
      </div>
    </div>
  </div>
</footer>
