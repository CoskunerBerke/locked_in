---
import brandConfig from '../../config/brand';

const currentYear = new Date().getFullYear();

const servicesList = [
  { name: 'Web Sitesi Tasarımı', href: '/hizmetler/web-sitesi-tasarimi/' },
  { name: 'Teknik ve Site İçi SEO', href: '/hizmetler/seo/' },
  { name: 'Mobil Uygulama Geliştirme', href: '/hizmetler/mobil-uygulama/' },
  { name: 'Yemeksepeti & Trendyol Yönetimi', href: '/hizmetler/yemeksepeti-trendyol-yemek/' },
  { name: 'Google Maps ve Yerel SEO', href: '/hizmetler/google-maps/' },
  { name: 'Instagram ve Meta Reklamları', href: '/hizmetler/instagram-reklamlari/' },
];

const legalLinks = [
  { name: 'Gizlilik Politikası', href: '/gizlilik-politikasi/' },
  { name: 'KVKK Aydınlatma Metni', href: '/kvkk-aydinlatma-metni/' },
  { name: 'Kullanım Koşulları', href: '/kullanim-kosullari/' },
];
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand Info -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src={brandConfig.logoPath} alt={brandConfig.brandName} class="h-9 w-auto bg-white p-1 rounded-md" />
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {brandConfig.description}
        </p>
        <div class="pt-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-sky-400">Hizmet Bölgesi</span>
          <p class="text-sm font-medium text-slate-300">{brandConfig.serviceArea}</p>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h2 class="text-base font-bold text-white mb-4">Hizmetlerimiz</h2>
        <ul class="space-y-2.5 text-sm">
          {
            servicesList.map((item) => (
              <li>
                <a href={item.href} class="text-slate-400 hover:text-sky-400 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Contact & Support -->
      <div>
        <h2 class="text-base font-bold text-white mb-4">İletişim</h2>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-sky-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>{brandConfig.phone}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-sky-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>{brandConfig.email}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-sky-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{brandConfig.address}</span>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Social -->
      <div>
        <h2 class="text-base font-bold text-white mb-4">Yasal & Kurumsal</h2>
        <ul class="space-y-2.5 text-sm mb-6">
          {
            legalLinks.map((item) => (
              <li>
                <a href={item.href} class="text-slate-400 hover:text-sky-400 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={brandConfig.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-sky-400 hover:text-sky-300 transition-colors"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Instagram'da Takip Edin
        </a>
      </div>
    </div>

    <!-- Independent Consulting Legal Disclaimer -->
    <div class="mt-8 pt-6 text-xs text-slate-500 border-t border-slate-800/60 leading-relaxed">
      <p class="mb-2">
        <strong class="text-slate-400">Yasal Bilgilendirme ve Bağımsızlık Beyanı:</strong>
        {brandConfig.brandName}, özel işletmelere dijital danışmanlık, web tasarımı, SEO, sosyal medya yönetimi ve panel operasyon desteği sunan bağımsız bir hizmet sağlayıcıdır.
      </p>
      <p>
        Sitede adı geçen <em>Yemeksepeti, Trendyol, Google, Meta, Instagram</em> ve diğer markalar kendi hak sahiplerinin tescilli markalarıdır. Şirketimizin bu markalarla resmî bir ortaklığı, acenteliği veya yetkili bayiliği bulunmamaktadır. Sunulan tüm hizmetler bağımsız operasyonel yönetim ve danışmanlık kapsamında yürütülmektedir.
      </p>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {currentYear} {brandConfig.legalCompanyName}. Tüm hakları saklıdır.</p>
      <p class="text-slate-600">Luminous Digital Systems Architecture</p>
    </div>
  </div>
</footer>
