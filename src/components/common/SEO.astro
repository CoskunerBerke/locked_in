---
import brandConfig from '../../config/brand';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
}

const {
  title = `${brandConfig.brandName} - Dijital Hizmetler ve Danışmanlık Ajansı`,
  description = brandConfig.description,
  image = '/brand/logo.svg',
  canonicalUrl,
  type = 'website',
} = Astro.props;

// Ensure clean canonical URL pointing directly to https://rentyazilim.com domain + current path
const siteBaseUrl = brandConfig.siteUrl.endsWith('/') ? brandConfig.siteUrl.slice(0, -1) : brandConfig.siteUrl;
const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '' || currentPath === '/' ? '/' : currentPath;
const calculatedCanonical = `${siteBaseUrl}${cleanPath}`;
const finalCanonicalUrl = canonicalUrl || calculatedCanonical;

// Ensure absolute OG image URL using rentyazilim.com
const ogImageUrl = image.startsWith('http') ? image : `${siteBaseUrl}${image.startsWith('/') ? image : '/' + image}`;

const isIndexingAllowed = brandConfig.indexingEnabled;
const robotsContent = isIndexingAllowed ? 'index, follow' : 'noindex, nofollow';
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<!-- Canonical URL -->
<link rel="canonical" href={finalCanonicalUrl} />

<!-- Sitemap Reference -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={finalCanonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content={brandConfig.brandName} />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={finalCanonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Favicon & PWA -->
<link rel="icon" href="/favicon.ico?v=3" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
<link rel="manifest" href="/site.webmanifest?v=3" />
<meta name="theme-color" content="#0EA5E9" />
