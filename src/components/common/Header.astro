---
import brandConfig from '../../config/brand';
import MobileMenu from './MobileMenu.react';

interface Props {
  activePage?: string;
}

const { activePage } = Astro.props;

const navLinks = [
  { name: 'Hizmetler', href: '/#hizmetler' },
  { name: 'Çözümler', href: '/hizmetler/yemeksepeti-trendyol-yemek/' },
  { name: 'Süreç', href: '/#surec' },
  { name: 'Hakkımızda', href: '/#neden-biz' },
  { name: 'SSS', href: '/#faq' },
  { name: 'İletişim', href: '/#teklif-formu' },
];
---

<!-- Accessibility Skip-to-Content Link -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-3 focus:bg-sky-600 focus:text-white focus:rounded-xl focus:shadow-xl font-medium transition-all"
>
  İçeriğe Atla
</a>

<header
  id="site-header"
  class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 transition-all duration-300" id="header-inner">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-sky-500 rounded-lg p-1">
        <img
          src={brandConfig.logoPath}
          alt={`${brandConfig.brandName} Logosu`}
          class="h-10 w-auto transition-transform group-hover:scale-105"
          width="180"
          height="40"
        />
      </a>

      <!-- Desktop Nav Items -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Ana Gezinme">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`text-sm font-semibold transition-colors hover:text-sky-600 ${
                activePage === link.href ? 'text-sky-600 font-bold' : 'text-slate-700'
              }`}
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Right Action CTAs & Mobile Toggle -->
      <div class="flex items-center gap-4">
        <a
          href="#teklif-formu"
          class="hidden sm:inline-flex btn-primary text-sm py-2.5 px-5 shadow-sm"
        >
          Ücretsiz Ön Görüşme
        </a>

        <MobileMenu client:load />
      </div>
    </div>
  </div>
</header>

<script>
  // Controlled shrink effect on scroll
  const header = document.getElementById('site-header');
  const headerInner = document.getElementById('header-inner');

  if (header && headerInner) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        headerInner.classList.remove('h-20');
        headerInner.classList.add('h-16');
        header.classList.add('shadow-md');
      } else {
        headerInner.classList.remove('h-16');
        headerInner.classList.add('h-20');
        header.classList.remove('shadow-md');
      }
    });
  }
</script>
