---
import brandConfig from '../../config/brand';
import MegaMenu from './MegaMenu.react';
import MobileMenu from './MobileMenu.react';

interface Props {
  activePage?: string;
}

const { activePage } = Astro.props;
---

<!-- Accessibility Skip-to-Content Link -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-3 focus:bg-sky-600 focus:text-white focus:rounded-xl focus:shadow-xl font-medium transition-all"
>
  İçeriğe Atla
</a>

<!-- Main Corporate Header -->
<header
  id="site-header"
  class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-shadow duration-200 transform-gpu translate-z-0 will-change-[transform,opacity]"
  style="transform: translateZ(0); will-change: transform;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-22 transition-none" id="header-inner">
      <!-- Large Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-sky-500 rounded-lg p-1">
        <img
          src={brandConfig.logoPath}
          alt={`${brandConfig.brandName} Logosu`}
          class="h-11 sm:h-14 lg:h-16 w-auto transition-transform group-hover:scale-105 object-contain"
          width="240"
          height="80"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Ana Gezinme">
        <a
          href="/"
          class={`text-base font-bold transition-colors hover:text-sky-600 ${
            activePage === '/' ? 'text-sky-600 font-extrabold' : 'text-slate-800'
          }`}
        >
          Ana Sayfa
        </a>

        {/* Mega Menu for Hizmetler */}
        <MegaMenu client:load />

        <a
          href="/projeler/"
          class={`text-base font-bold transition-colors hover:text-sky-600 ${
            activePage === '/projeler/' ? 'text-sky-600 font-extrabold' : 'text-slate-800'
          }`}
        >
          Projeler
        </a>

        <a
          href="/akademi/"
          class={`text-base font-bold transition-colors hover:text-sky-600 ${
            activePage === '/akademi/' ? 'text-sky-600 font-extrabold' : 'text-slate-800'
          }`}
        >
          Akademi
        </a>

        <a
          href="/hakkimizda/"
          class={`text-base font-bold transition-colors hover:text-sky-600 ${
            activePage === '/hakkimizda/' ? 'text-sky-600 font-extrabold' : 'text-slate-800'
          }`}
        >
          Kurumsal
        </a>

        <a
          href="/iletisim/"
          class={`text-base font-bold transition-colors hover:text-sky-600 ${
            activePage === '/iletisim/' ? 'text-sky-600 font-extrabold' : 'text-slate-800'
          }`}
        >
          İletişim
        </a>
      </nav>

      <!-- Right Red CTA & Mobile Toggle -->
      <div class="flex items-center gap-4">
        <a
          href="/iletisim/"
          class="hidden sm:inline-flex btn-cta text-sm py-3 px-6 shadow-md"
        >
          Ücretsiz Ön Görüşme
        </a>

        <MobileMenu client:load />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  let ticking = false;

  if (header) {
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 20) {
            header.classList.add('shadow-md');
          } else {
            header.classList.remove('shadow-md');
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
